# Copie para .env.local e preencha com as chaves do seu projeto Supabase
# (Painel Supabase → Settings → API Keys).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret: só é lida em código de servidor (Route Handlers). NUNCA prefixar com
# NEXT_PUBLIC_ nem importar lib/supabaseAdmin.ts de um componente "use client".
SUPABASE_SECRET_KEY=
